{
  "name": "@baicie/plugin-dts",
  "version": "0.0.2",
  "description": "A rollup plugin that will bundle up your .d.ts definition files.",
  "keywords": [
    "rollup-plugin",
    "typescript",
    "dts",
    "@types"
  ],
  "packageManager": "pnpm@10.33.4",
  "author": "baicie",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/rollup-plugin-dts.git"
  },
  "bugs": {
    "url": "https://github.com/baicie/rollup-plugin-dts/issues"
  },
  "homepage": "https://github.com/baicie/rollup-plugin-dts#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/rollup-plugin-dts.cjs",
  "types": "./dist/rollup-plugin-dts.d.mts",
  "exports": {
    ".": {
      "types": "./dist/rollup-plugin-dts.d.mts",
      "import": "./dist/rollup-plugin-dts.mjs",
      "require": "./dist/rollup-plugin-dts.cjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs",
      "require": "./dist/rolldown.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c",
    "prepublishOnly": "npm run test",
    "pretest": "npm run build",
    "test": "c8 node temp/tests/index.js",
    "release": "tsx scripts/release.ts",
    "ci-publish": "tsx scripts/publish.ts",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "tsx scripts/verify-commit.ts"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@baicie/release": "^0.1.15",
    "@baicie/scripts": "^0.1.2",
    "@babel/code-frame": "^7.29.7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/babel__code-frame": "^7.27.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/d3-drag": "^3.0.7",
    "@types/estree": "1.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "c8": "^11.0.0",
    "rolldown": "^1.0.2",
    "rollup": "4.60.4",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "rollup": "^3.29.4 || ^4",
    "rolldown": "^1",
    "typescript": "^4.5 || ^5.0 || ^6.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@babel/code-frame": "^7.29.7"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "convert-source-map": "^2.0.0",
    "magic-string": "^0.30.21"
  },
  "overrides": {
    "c8": {
      "yargs": "^18.0.0"
    }
  }
}
